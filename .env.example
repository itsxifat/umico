# ─────────────────────────────────────────────
# UMICO — Environment Variables
# Copy this to .env.local and fill in the values.
# ─────────────────────────────────────────────

# Database
MONGODB_URI=mongodb://localhost:27017/umico

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string

# Google OAuth (optional — credentials login works without it)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP (Nodemailer) — required for OTP, order emails, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=UMICO
SMTP_FROM_EMAIL=

# Steadfast Courier
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_BASE_URL=https://portal.steadfast.com.bd/api/v1
STEADFAST_WEBHOOK_SECRET=

# Site
SITE_URL=http://localhost:3000
SITE_NAME=UMICO

# Image Upload
MAX_FILE_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Analytics (optional)
GOOGLE_ANALYTICS_ID=
FACEBOOK_PIXEL_ID=

# Super admin bootstrap — the first user with this email will be promoted
# to superadmin on registration. Leave empty to disable.
BOOTSTRAP_SUPERADMIN_EMAIL=
